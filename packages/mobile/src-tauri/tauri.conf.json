{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yep Anywhere",
  "version": "../../../package.json",
  "identifier": "com.yepanywhere.mobile.local",
  "build": {
    "frontendDist": "../static-shim"
  },
  "app": {
    "windows": [
      {
        "title": "Yep Anywhere",
        "useHttpsScheme": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": { "minimumSystemVersion": "15.0" }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "host": "yepanywhere.com", "pathPrefix": ["/open"] }]
    }
  }
}

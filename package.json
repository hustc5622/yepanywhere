{
  "name": "yep-anywhere",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:core": "corepack pnpm --filter yep-anywhere --filter @yep-anywhere/server... --filter @yep-anywhere/client... install",
    "setup-vapid": "tsx scripts/setup-vapid.ts",
    "codex:protocol:update": "node scripts/update-codex-protocol.mjs",
    "codex:protocol:sync": "node scripts/update-codex-protocol.mjs --sync",
    "codex:protocol:check": "node scripts/update-codex-protocol.mjs --check",
    "codex:protocol:test": "corepack pnpm --filter @yep-anywhere/server test -- test/sdk/providers/codex-protocol.test.ts",
    "feishu:migration:preflight": "node scripts/feishu-migration-preflight.mjs",
    "benchmark:ohmyrouter": "tsx scripts/benchmark-ohmyrouter.ts",
    "version:status": "tsx scripts/version.ts status",
    "version:bump": "tsx scripts/version.ts bump",
    "version:check": "tsx scripts/version.ts check",
    "deploy": "scripts/deploy.sh",
    "hot-apply": "node scripts/hot-apply.mjs",
    "launchd:install": "scripts/install-launchagents.sh",
    "launchd:uninstall": "scripts/uninstall-launchagents.sh",
    "predev": "corepack pnpm codex:protocol:sync",
    "dev": "node scripts/dev.js",
    "predev:8022": "corepack pnpm codex:protocol:sync",
    "dev:8022": "node scripts/dev-8022.js",
    "predev:8022:replace": "corepack pnpm codex:protocol:sync",
    "dev:8022:replace": "node scripts/dev-8022.js --replace",
    "predev:auto": "corepack pnpm codex:protocol:sync",
    "prestaging": "corepack pnpm codex:protocol:sync",
    "staging": "node scripts/staging.js",
    "dev:auto": "corepack pnpm --filter server dev & corepack pnpm --filter client dev",
    "dev-tailscale": "tailscale serve --bg 3400 && corepack pnpm dev",
    "start": "NODE_ENV=production node packages/server/dist/index.js",
    "build": "corepack pnpm -r build",
    "build:bundle": "tsx scripts/build-bundle.ts",
    "build:stable": "corepack pnpm --filter client build:stable",
    "typecheck": "corepack pnpm --filter shared build && corepack pnpm -r --filter '!@yep-anywhere/mobile' exec tsc --noEmit",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter client test:e2e",
    "test:codex-app-server-smoke": "tsx --conditions source scripts/smoke-codex-app-server.ts",
    "test:codex-lifecycle-hydration-smoke": "tsx --conditions source scripts/smoke-codex-lifecycle-hydration.ts --disposable",
    "test:codex-history-read-smoke": "tsx --conditions source scripts/smoke-codex-history-read.ts --read-only --summary",
    "test:e2e:ui": "corepack pnpm --filter client test:e2e:ui",
    "test:e2e:sdk": "corepack pnpm --filter server test:e2e",
    "lint": "corepack pnpm lint:typography && biome check .",
    "lint:typography": "node scripts/check-typography.mjs",
    "test:typography": "node --test scripts/check-typography.test.mjs",
    "format": "biome format --write .",
    "prepare": "husky",
    "postinstall": "chmod +x node_modules/.pnpm/node-pty@*/node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null; exit 0",
    "site:dev": "cd site && npm run dev",
    "site:build": "cd site && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "husky": "^9.1.7",
    "postcss": "8.5.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "overrides": {
      "bn.js": "5.2.3"
    }
  },
  "yepAnywhere": {
    "codexCli": {
      "expectedVersion": "0.151.0"
    }
  },
  "dependencies": {},
  "version": "2026.10.0"
}
